# Port der Weboberfläche
APP_PORT=8000

# OpenAI-kompatibler Endpunkt des On-Prem-LLM (mit /v1 am Ende)
#   Ollama:    http://host.docker.internal:11434/v1
#   vLLM:      http://llm-server:8000/v1
#   LM Studio: http://host.docker.internal:1234/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

LLM_TEMPERATURE=0
LLM_TIMEOUT=300
# Wie viele Zeichen des PDF-Textes maximal ans LLM gehen (an das Kontextfenster anpassen)
LLM_MAX_CHARS=60000
# false setzen, falls der Server response_format nicht unterstützt
LLM_JSON_MODE=true
# false setzen bei selbstsignierten Zertifikaten im internen Netz
LLM_VERIFY_SSL=true
